rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Μόνο οι δύο λογαριασμοί Google της οικογένειας έχουν πρόσβαση.
    // ΑΛΛΑΞΕ τα δύο email παρακάτω (πεζά γράμματα).
    function isFamily() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          'EMAIL_1@gmail.com',
          'EMAIL_2@gmail.com'
        ];
    }

    // Το προφίλ μπορεί να γραφτεί μόνο από τον ίδιο τον χρήστη
    match /users/{uid} {
      allow read: if isFamily();
      allow write: if isFamily() && request.auth.uid == uid;
    }

    // Μηνύματα: μόνο ο συντάκτης αλλάζει/σβήνει το δικό του. Ο άλλος μπορεί να αλλάξει μόνο τα likes.
    match /messages/{id} {
      allow read: if isFamily();
      allow create: if isFamily() && request.resource.data.by == request.auth.uid;
      allow update: if isFamily() && (
        resource.data.by == request.auth.uid
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
      );
      allow delete: if isFamily() && resource.data.by == request.auth.uid;
    }

    // Όλα τα υπόλοιπα (ψώνια, λογαριασμοί, δαπάνες, events)
    match /{col}/{docId} {
      allow read, write: if isFamily() && col in ['shopping', 'bills', 'expenses', 'events'];
    }
  }
}
